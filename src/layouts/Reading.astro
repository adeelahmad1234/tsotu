---
import Base from './Base.astro';
import Brand from '../components/Brand.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';
import TopicNav from '../components/TopicNav.astro';
import TopicRail from '../components/TopicRail.astro';

// Entry pages and the 404: logo top left, a centred reading column, and the topics folded
// into a slim rail on the right that opens the full menu. Below 1024px the Topics button
// opens the same menu full screen.
const { topics, currentId, ...seo } = Astro.props;
---

<Base {...seo}>
  <div class="mx-auto grid min-h-svh max-w-7xl grid-rows-[auto_auto_1fr] px-6 py-8 lg:grid-cols-12 lg:gap-x-8 lg:px-12 lg:py-12">
    <header class="flex items-start justify-between gap-6 lg:col-span-12">
      <Brand variant="logo" />
      <Button popovertarget="topics" class="lg:hidden">Topics</Button>
    </header>
    <div class="hidden lg:col-span-2 lg:col-start-11 lg:row-start-2 lg:mt-16 lg:block">
      <TopicRail topics={topics} class="sticky top-12 ml-auto" />
    </div>
    <main class="mt-12 lg:col-span-8 lg:col-start-3 lg:row-start-2 lg:mt-16">
      <div class="mx-auto max-w-2xl">
        <slot />
      </div>
    </main>
    <Footer class="mt-24 self-end lg:col-span-4" />
  </div>

  <div id="topics" popover class="topics-panel vt-panel">
    <div class="flex justify-end">
      <button type="button" popovertarget="topics" popovertargetaction="hide" class="panel-arrow hidden lg:block" aria-label="Close topics">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" /></svg>
      </button>
      <Button popovertarget="topics" popovertargetaction="hide" class="lg:hidden">Close</Button>
    </div>
    <TopicNav topics={topics} currentId={currentId} idPrefix="panel" compact class="mt-8 lg:mt-4" />
  </div>
</Base>

<script>
  const panel = document.getElementById('topics');
  const rail = document.querySelector('[data-rail]');

  // On desktop the menu unfolds out of the rail's arrow, so it is placed on the arrow first.
  rail.addEventListener('click', (event) => {
    // The rail's right edge, not the arrow's: the arrow shifts slightly while hovered.
    panel.style.setProperty('--arrow-top', `${rail.querySelector('svg').getBoundingClientRect().top}px`);
    panel.style.setProperty('--arrow-right', `${rail.getBoundingClientRect().right}px`);
    // Clicking a topic's line or name opens the menu on that topic; the arrow opens it on the current one.
    const topic =
      event.target.closest('[data-topic]')?.dataset.topic ??
      panel.querySelector('[aria-current="page"]')?.closest('.topic-panel')?.id.replace('panel-', '');
    if (topic) {
      for (const toggle of panel.querySelectorAll('.topic-toggle')) {
        toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-controls') === `panel-${topic}`));
      }
    }
  });

  // Opening or closing the menu puts the rail at rest (no names) until the pointer moves away
  // from both, so the menu unfolds and folds cleanly instead of the names springing back.
  const settle = (event) => {
    if (rail.contains(event.target) || panel.contains(event.target)) return;
    delete rail.dataset.quiet;
    removeEventListener('pointermove', settle);
  };
  panel.addEventListener('toggle', () => {
    rail.dataset.quiet = '';
    addEventListener('pointermove', settle, { passive: true });
  });

  // The menu is placed differently on phones and desktops, so close it if the width changes.
  let width = innerWidth;
  addEventListener('resize', () => {
    if (innerWidth === width) return;
    width = innerWidth;
    if (panel.matches(':popover-open')) panel.hidePopover();
  });
</script>
