---
import Button from './Button.astro';

// Previous and next entry within the same topic, in the order set by `order`.
const { previous, next, topicName } = Astro.props;
---

{(previous || next) && (
  <nav aria-label={`More in ${topicName}`} class="mt-16 grid grid-cols-2 gap-6 border-t border-rule pt-8">
    <div>
      {previous && (
        <Fragment>
          <Button href={previous.href} aria-label={`Previous: ${previous.data.title}`}>Previous</Button>
          <p class="mt-3 text-sm text-ink-muted">{previous.data.title}</p>
        </Fragment>
      )}
    </div>
    <div class="text-right">
      {next && (
        <Fragment>
          <Button href={next.href} variant="dark" aria-label={`Next: ${next.data.title}`}>Next</Button>
          <p class="mt-3 text-sm text-ink-muted">{next.data.title}</p>
        </Fragment>
      )}
    </div>
  </nav>
)}
